# ==============================================================================
# Aurahub Environment Variables Template
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local with real secrets to version control.
# ==============================================================================

# Core Database & Cache
MONGO_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/aurahub"
REDIS_URL="redis://default:<password>@<host>:<port>"

# NextAuth Authentication
NEXTAUTH_SECRET="your-32-character-random-secret"
NEXTAUTH_URL="http://localhost:3000"
JWT_SECRET="your-jwt-secret-key"

# OAuth Providers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI & Media Storage
GEMINI_API_KEY=""
FREEIMAGE_API_KEY=""
UPLOAD_FOLDER_ID=""

# Realtime Go Notifier
NOTIFICATION_SERVER_URL="https://aurahub-go-notifier.onrender.com"
NEXT_PUBLIC_NOTIFICATION_SERVER_URL="https://aurahub-go-notifier.onrender.com"
