# Aurahub Production Docker Environment Configuration

# Database Credentials
POSTGRES_USER=aurahub
POSTGRES_PASSWORD=generate_a_secure_database_password_here
POSTGRES_DB=aurahub

# Port Overrides
AURAHUB_PORT=8080
FRONTEND_PORT=5173

# Application Secrets
JWT_SECRET=generate_a_long_cryptographically_secure_jwt_secret_at_least_32_chars

# CORS Allowed Origins (Comma-separated)
FRONTEND_ORIGINS=https://aurahub.yourdomain.com,http://localhost:5173

# External Upload Credentials (optional, leave blank if not using external storage)
UPLOAD_FOLDER_ID=
FREEIMAGE_API_KEY=
