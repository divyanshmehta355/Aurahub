# Environment Configuration

# Read-only MongoDB source for `go run ./cmd/migrate-mongo`
MONGO_URI=mongodb://localhost:27017/legacy_database
# Set only when MONGO_URI does not contain a database name
MONGO_DATABASE=

# Server
PORT=8080

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aurahub?sslmode=disable

# Cache / Session (Valkey)
VALKEY_URL=redis://localhost:6379/0

# Required authentication secret; use a long, random value
JWT_SECRET=replace_with_a_long_random_secret

# Frontend CORS
FRONTEND_ORIGINS=http://localhost:5173

# External upload services
UPLOAD_FOLDER_ID=your_upload_folder_id
FREEIMAGE_API_KEY=your_freeimage_api_key

# Event Streaming (Kafka - e.g. Aiven)
KAFKA_BROKERS=your-service.aivencloud.com:11000

# Option A: Zero-Certificate SASL (Username & Password) - Recommended if avoiding cert files
KAFKA_USER=avnadmin
KAFKA_PASSWORD=your_aiven_password
KAFKA_AUTH_METHOD=scram-sha-512
# KAFKA_INSECURE_SKIP_VERIFY=true  # (Defaults to true automatically when no CA cert is set)

# Option B: Aiven Client Certificates (mTLS) - If downloading .pem files from Aiven
# KAFKA_CA_CERT_PATH=./certs/ca.pem
# KAFKA_CLIENT_CERT_PATH=./certs/service.cert
# KAFKA_CLIENT_KEY_PATH=./certs/service.key


